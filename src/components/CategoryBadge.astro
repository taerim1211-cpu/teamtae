---
import { CATEGORIES, type CategorySlug } from '../lib/categories';
import { withBase } from '../lib/paths';

interface Props {
  category: CategorySlug;
  class?: string;
}

const { category, class: className = '' } = Astro.props;
const c = CATEGORIES[category];
---

<a
  href={withBase(`/category/${c.slug}/`)}
  class={`font-sans text-xs font-semibold uppercase tracking-[0.08em] transition hover:underline hover:underline-offset-4 ${c.text} ${className}`}
>
  {c.label}
</a>
