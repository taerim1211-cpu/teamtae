---
import { Icon } from 'astro-icon/components';
import { CATEGORY_LIST } from '../lib/categories';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const navLink = (href: string) =>
  pathname === href || (href !== '/' && pathname.startsWith(href))
    ? 'text-stone-900 dark:text-stone-50'
    : 'text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-50';
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-stone-50/80 backdrop-blur dark:border-stone-800/80 dark:bg-stone-950/80">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">
      teamtae
    </a>

    <nav class="hidden items-center gap-5 font-sans text-sm sm:flex">
      {CATEGORY_LIST.map((c) => (
        <a href={`/category/${c.slug}/`} class={`transition ${navLink(`/category/${c.slug}/`)}`}>
          {c.label}
        </a>
      ))}
      <a href="/about/" class={`transition ${navLink('/about/')}`}>About</a>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/rss.xml"
        aria-label="RSS feed"
        title="RSS feed"
        class="inline-flex h-11 w-11 items-center justify-center text-stone-600 transition hover:bg-stone-200/60 hover:text-stone-900 active:scale-[0.92] dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
      >
        <Icon name="ph:rss" class="h-4.5 w-4.5" />
      </a>
      <ThemeToggle />
    </div>
  </div>

  <nav
    class="flex items-center gap-4 overflow-x-auto border-t border-stone-200/80 px-5 py-2.5 font-sans text-sm sm:hidden dark:border-stone-800/80 [mask-image:linear-gradient(to_right,transparent,black_1rem,black_calc(100%-1.5rem),transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_1rem,black_calc(100%-1.5rem),transparent)]"
  >
    {CATEGORY_LIST.map((c) => (
      <a href={`/category/${c.slug}/`} class={`shrink-0 whitespace-nowrap transition ${navLink(`/category/${c.slug}/`)}`}>
        {c.label}
      </a>
    ))}
    <a href="/about/" class={`shrink-0 whitespace-nowrap pr-4 transition ${navLink('/about/')}`}>About</a>
  </nav>
</header>
