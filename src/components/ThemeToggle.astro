---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  class="inline-flex h-11 w-11 items-center justify-center text-stone-600 transition hover:bg-stone-200/60 hover:text-stone-900 active:scale-[0.92] dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
>
  <Icon name="ph:sun" class="hidden h-5 w-5 dark:block" />
  <Icon name="ph:moon" class="block h-5 w-5 dark:hidden" />
</button>

<script>
  const STORAGE_KEY = 'theme';

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.classList.toggle('dark', theme === 'dark');
  }

  function currentTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'light' || stored === 'dark') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    localStorage.setItem(STORAGE_KEY, next);
    applyTheme(next);
  });
</script>
