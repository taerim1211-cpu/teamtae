---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORY_LIST } from '../lib/categories';
import { withBase } from '../lib/paths';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 6);

const postCounts = CATEGORY_LIST.reduce<Record<string, number>>((counts, c) => {
  counts[c.slug] = allPosts.filter((post) => post.data.category === c.slug).length;
  return counts;
}, {});
---

<Layout title="teamtae">
  <section class="mb-14">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl dark:text-stone-50">
      teamtae
    </h1>
    <p class="mt-4 max-w-xl font-sans text-lg leading-relaxed text-stone-600 dark:text-stone-400">
      Notes on sports, education, investment, books, and technology, written as I figure things out.
    </p>
  </section>

  <section class="mb-14">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
      {CATEGORY_LIST.map((c) => (
        <a
          href={withBase(`/category/${c.slug}/`)}
          class={`border px-4 py-3 font-sans transition hover:bg-stone-900/[0.03] dark:hover:bg-stone-50/[0.05] ${c.text} ${c.border}`}
        >
          <div class="text-sm font-medium">{c.label}</div>
          <div class="mt-0.5 text-xs">
            {postCounts[c.slug]} {postCounts[c.slug] === 1 ? 'post' : 'posts'}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="mb-6 flex items-center justify-between font-sans">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-500">
        Latest posts
      </h2>
      <a href={withBase('/blog/')} class="text-sm font-medium text-stone-500 transition hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-50">
        View all &rarr;
      </a>
    </div>

    {posts.length > 0 ? (
      <div class="divide-y divide-stone-200/80 dark:divide-stone-800/80">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="font-sans text-stone-500 dark:text-stone-400">
        No posts yet. The first one is on its way.
      </p>
    )}
  </section>
</Layout>
