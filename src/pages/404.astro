---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="flex min-h-[40vh] flex-col items-start justify-center">
    <p class="font-serif text-6xl font-semibold text-neutral-900 dark:text-white">404</p>
    <p class="mt-3 text-neutral-500 dark:text-neutral-400">This page doesn't exist.</p>
    <a href="/" class="mt-6 text-sm font-medium text-neutral-900 underline underline-offset-4 dark:text-white">
      Back home
    </a>
  </div>
</Layout>
