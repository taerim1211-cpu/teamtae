---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
---

<Layout title="Page not found">
  <div class="flex min-h-[40vh] flex-col items-start justify-center">
    <p class="font-serif text-6xl font-semibold text-stone-900 dark:text-stone-50">404</p>
    <p class="mt-3 font-sans text-stone-500 dark:text-stone-400">This page doesn't exist.</p>
    <a href={withBase('/')} class="mt-6 font-sans text-sm font-medium text-stone-900 underline underline-offset-4 dark:text-stone-50">
      Back home
    </a>
  </div>
</Layout>
