---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugifyTag } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagMap = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagMap.set(slugifyTag(tag), tag);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, label]) => ({
    params: { tag: slug },
    props: { label },
  }));
}

const { tag: tagSlug } = Astro.params;
const { label } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.tags.some((t) => slugifyTag(t) === tagSlug))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`#${label}`} description={`Posts tagged "${label}".`}>
  <div class="mb-2 text-sm font-medium uppercase tracking-wide text-neutral-400 dark:text-neutral-500">Tag</div>
  <h1 class="font-serif text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white">
    #{label}
  </h1>

  <div class="mt-8 divide-y divide-neutral-200/80 dark:divide-neutral-800/80">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>
