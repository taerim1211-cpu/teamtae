---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import PostCard from '../components/PostCard.astro';
import { slugifyTag } from '../lib/tags';
import { withBase } from '../lib/paths';
import { CATEGORIES } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { id, title, description, pubDate, updatedDate, category, tags } = Astro.props;

const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleUrl = new URL(withBase(`/blog/${id}/`), Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'teamtae' },
  publisher: { '@type': 'Person', name: 'teamtae' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  keywords: tags.join(', '),
  articleSection: CATEGORIES[category].label,
};

const otherPosts = (await getCollection('blog', ({ data, id: otherId }) => !data.draft && otherId !== id)).sort(
  (a, b) => {
    const aSameCategory = a.data.category === category ? 0 : 1;
    const bSameCategory = b.data.category === category ? 0 : 1;
    if (aSameCategory !== bSameCategory) return aSameCategory - bSameCategory;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  }
);
const relatedPosts = otherPosts.slice(0, 2);
---

<Layout
  title={title}
  description={description}
  article={true}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  section={CATEGORIES[category].label}
  tags={tags}
  structuredData={structuredData}
>
  <article>
    <a href={withBase('/blog/')} class="mb-8 inline-flex items-center gap-1 font-sans text-sm font-medium text-stone-500 transition hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-50">
      <Icon name="ph:arrow-left" class="h-3.5 w-3.5" />
      All posts
    </a>

    <header class="mb-10">
      <div class="mb-4 flex items-center gap-3">
        <CategoryBadge category={category} />
        <time datetime={pubDate.toISOString()} class="font-sans text-xs text-stone-500 dark:text-stone-500">
          {formatted}
          {formattedUpdated && ` · updated ${formattedUpdated}`}
        </time>
      </div>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-50">
        {title}
      </h1>
      <p class="mt-4 max-w-[65ch] font-sans text-lg leading-relaxed text-stone-600 dark:text-stone-400">
        {description}
      </p>
    </header>

    <div class="prose prose-stone font-serif text-lg dark:prose-invert" data-post-content>
      <slot />
    </div>

    <script>
      // Open external links in post content in a new tab.
      document.querySelectorAll<HTMLAnchorElement>('[data-post-content] a[href]').forEach((link) => {
        if (link.host && link.host !== location.host) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      });
    </script>

    {tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-stone-200/80 pt-6 dark:border-stone-800/80">
        {tags.map((tag) => (
          <a
            href={withBase(`/tags/${slugifyTag(tag)}/`)}
            class="border border-stone-300 px-2.5 py-1 font-sans text-xs text-stone-600 transition hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-400 dark:hover:border-stone-500 dark:hover:text-stone-50"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </article>

  {relatedPosts.length > 0 && (
    <section class="mt-16 border-t border-stone-200/80 pt-10 dark:border-stone-800/80">
      <h2 class="mb-2 font-sans text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-500">
        Keep reading
      </h2>
      <div class="divide-y divide-stone-200/80 dark:divide-stone-800/80">
        {relatedPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</Layout>
